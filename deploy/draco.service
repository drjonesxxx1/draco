[Unit]
Description=DRACO — Book-Forged Code Oracle
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/draco
ExecStart=/opt/draco/venv/bin/gunicorn -w 2 --threads 8 -b 127.0.0.1:8012 --timeout 300 app:app
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
